% =========================================================================
% ANALYSE DES ERREURS DE FREQUENCES MESUREES SUR 3 AXES (MONTE-CARLO)
% =========================================================================
clear; clc; close all;

%% 1. DONNÉES D'ENTRÉE (Exemple simulé - À remplacer par vos données)
N = 1000; % Nombre de runs Monte-Carlo

% Fréquences Vérité Terrain (GT) sur [X, Y, Z] en Hz
f_GT = [25.0, 50.0, 100.0]; % Format [1 x 3] (ou [N x 3] si GT varie par run)

% Simulation de mesures f_hat [N x 3] avec biais, bruit et quelques aberrants
rng(42); % Graine aléatoire pour répétabilité
bias_sim = [0.05, -0.12, 0.02];  % Biais simulé (Hz)
std_sim  = [0.10,  0.25, 0.40];  % Écart-type simulé (Hz)

f_hat = f_GT + bias_sim + std_sim .* randn(N, 3);
outliers = randperm(N, round(0.02*N)); 
f_hat(outliers, :) = f_hat(outliers, :) + 1.2 * randn(length(outliers), 3); % Outliers (2%)

%% 2. CALCUL DES MÉTROLOGIES ET INDICATEURS STATISTIQUES

% S'assurer du formatage des dimensions [N x 3]
if size(f_GT, 1) == 1
    f_GT_matrix = repmat(f_GT, N, 1);
else
    f_GT_matrix = f_GT;
end

% 2.1. Erreurs résiduelles par axe : e_i^(k) = f_hat_i^(k) - f_GT_i^(k)
err = f_hat - f_GT_matrix; % Matrix [N x 3]

% 2.2. Indicateurs scalaires par axe
bias_err = mean(err, 1);                   % Biais moyen (Hz)
std_err  = std(err, 0, 1);                 % Écart-type / Précision (Hz)
rmse_err = sqrt(mean(err.^2, 1));          % RMSE par axe (Hz)
mape_err = mean(abs(err ./ f_GT_matrix), 1) * 100; % Erreur Relative (MAPE %)

% 2.3. Erreur globale vectorielle 3D par run
err_3D  = sqrt(sum(err.^2, 2));            % Norme euclidienne [N x 1] (Hz)
rmse_3D = sqrt(mean(err_3D.^2));           % RMSE global 3D
p95_3D  = prctile(err_3D, 95);             % Percentile 95% (Worst-case 95%)

%% 3. AFFICHAGE DU TABLEAU SYNTHÉTIQUE DANS LA CONSOLE
fprintf('\n=========================================================================\n');
fprintf('         SYNTHÈSE DES ERREURS DE FRÉQUENCE MONTE-CARLO (%d RUNS)\n', N);
fprintf('=========================================================================\n');
fprintf('Axe    GT Moyen (Hz)   Biais (Hz)   Écart-type (Hz)   RMSE (Hz)   MAPE (%%)\n');
fprintf('-------------------------------------------------------------------------\n');
axes_names = {'X', 'Y', 'Z'};
for i = 1:3
    fprintf(' %s     %11.2f   %10.4f   %15.4f   %9.4f   %8.2f\n', ...
        axes_names{i}, mean(f_GT_matrix(:,i)), bias_err(i), std_err(i), rmse_err(i), mape_err(i));
end
fprintf('-------------------------------------------------------------------------\n');
fprintf('INDICATEURS GLOBAUX 3D :\n');
fprintf('  -> RMSE 3D           : %.4f Hz\n', rmse_3D);
fprintf('  -> Percentile 95 (P95) : %.4f Hz\n', p95_3D);
fprintf('=========================================================================\n\n');

%% 4. GRAPHICAL VISUALIZATION (FIGURE 4-IN-1)
fig = figure('Name', 'Comparaison Fréquences vs GT (Monte-Carlo)', ...
             'Color', 'w', 'Position', [100, 100, 1100, 800]);

% Palette de couleurs harmonieuses (Bleu, Rouge/Coral, Vert)
colors = [0.12, 0.47, 0.71;   % Axe X
          0.85, 0.28, 0.25;   % Axe Y
          0.18, 0.62, 0.37];  % Axe Z

t = tiledlayout(2, 2, 'TileSpacing', 'Compact', 'Padding', 'Compact');
title(t, sprintf('Analyse Métrologique des Fréquences Mesurées (%d Runs MC)', N), ...
    'FontSize', 14, 'FontWeight', 'bold');

% --- CADRAN 1: Boxplots comparatifs par axe ---
nexttile;
hold on;
hBox = boxplot(err, 'Labels', {'Axe X', 'Axe Y', 'Axe Z'}, 'Widths', 0.4, ...
               'Symbol', 'r+'); % Symbol 'r+' pour faire ressortir les outliers
grid on; box on;
yline(0, 'k--', 'LineWidth', 1.2, 'Alpha', 0.7);
ylabel('Erreur \Delta f = \hat{f} - f_{GT}  (Hz)', 'FontSize', 10);
title('1. Distribution & Outliers (Boxplots)', 'FontSize', 11, 'FontWeight', 'bold');

% --- CADRAN 2: Histogrammes & Densités de Probabilité (PDF) ---
nexttile;
hold on;
for i = 1:3
    % Histogramme normalisé (Densité)
    histogram(err(:, i), 'Normalization', 'pdf', 'FaceColor', colors(i, :), ...
              'FaceAlpha', 0.3, 'EdgeColor', colors(i, :), ...
              'DisplayName', sprintf('Axe %s', axes_names{i}));
          
    % Fit Gaussien Théorique
    x_grid = linspace(min(err(:, i)), max(err(:, i)), 200);
    pdf_fit = normpdf(x_grid, bias_err(i), std_err(i));
    plot(x_grid, pdf_fit, 'Color', colors(i, :), 'LineWidth', 2, 'HandleVisibility', 'off');
end
grid on; box on;
xlabel('Erreur \Delta f (Hz)', 'FontSize', 10);
ylabel('Densité de probabilité (PDF)', 'FontSize', 10);
title('2. Centrage & Normalité (Histogramme + Fit Gaussien)', 'FontSize', 11, 'FontWeight', 'bold');
legend('Location', 'northeast');

% --- CADRAN 3: Nuage de points par Run (Stabilité & Drift) ---
nexttile;
hold on;
runs = 1:N;
for i = 1:3
    % Scatter léger pour visualiser la dispersion
    scatter(runs, err(:, i), 8, colors(i, :), 'filled', 'MarkerFaceAlpha', 0.25, ...
            'HandleVisibility', 'off');
    % Ligne horizontale de Biais Moyen
    yline(bias_err(i), 'Color', colors(i, :), 'LineWidth', 2, ...
          'DisplayName', sprintf('Biais %s: %.3f Hz', axes_names{i}, bias_err(i)));
end
grid on; box on;
xlabel('Numéro du Run Monte-Carlo', 'FontSize', 10);
ylabel('Erreur \Delta f (Hz)', 'FontSize', 10);
title('3. Dispersion & Biais au fil des Runs', 'FontSize', 11, 'FontWeight', 'bold');
legend('Location', 'northeast');

% --- CADRAN 4: Distribution Cumulée (ECDF) de l'Erreur 3D ---
nexttile;
hold on;
[f_ecdf, x_ecdf] = ecdf(err_3D);
plot(x_ecdf, f_ecdf * 100, 'Color', [0.2 0.2 0.2], 'LineWidth', 2, 'DisplayName', 'ECDF Erreur 3D');

% Trait repère Percentile 95
xline(p95_3D, 'r--', 'LineWidth', 1.5, 'DisplayName', sprintf('P95 = %.3f Hz', p95_3D));
yline(95, 'k:', 'LineWidth', 1, 'HandleVisibility', 'off');
plot(p95_3D, 95, 'ro', 'MarkerFaceColor', 'r', 'MarkerSize', 6, 'HandleVisibility', 'off');

grid on; box on;
xlabel('Erreur Vectorielle 3D ||e_{3D}|| (Hz)', 'FontSize', 10);
ylabel('Probabilité Cumulée (%)', 'FontSize', 10);
title('4. Erreur Global 3D (Courbe ECDF)', 'FontSize', 11, 'FontWeight', 'bold');
legend('Location', 'southeast');
